{{- $incidents := where .Site.RegularPages "Params.section" "issue" -}}
{{- $active := where $incidents "Params.resolved" "=" false -}}
{{- $summaryRank := 0 -}}
{{- $summaryStatus := "operational" -}}
{{- range $issue := $active -}}
  {{- $candidate := "" -}}
  {{- with $issue.Params.componentStatus -}}
    {{- $candidate = lower (replace . "-" "_") -}}
  {{- else -}}
    {{- if eq $issue.Params.severity "down" -}}{{- $candidate = "major_outage" -}}
    {{- else if eq $issue.Params.severity "disrupted" -}}{{- $candidate = "partial_outage" -}}
    {{- else if eq $issue.Params.severity "notice" -}}{{- $candidate = "degraded_performance" -}}{{- end -}}
  {{- end -}}
  {{- $candidateRank := 0 -}}
  {{- if eq $candidate "degraded_performance" -}}{{- $candidateRank = 2 -}}{{- end -}}
  {{- if eq $candidate "under_maintenance" -}}{{- $candidateRank = 3 -}}{{- end -}}
  {{- if eq $candidate "partial_outage" -}}{{- $candidateRank = 4 -}}{{- end -}}
  {{- if eq $candidate "major_outage" -}}{{- $candidateRank = 5 -}}{{- end -}}
  {{- if gt $candidateRank $summaryRank -}}{{- $summaryRank = $candidateRank -}}{{- $summaryStatus = $candidate -}}{{- end -}}
{{- end -}}
{
  "is": "index",
  "cStateVersion": "6.0.1",
  "apiVersion": "3.0-shareline",
  "title": {{ .Site.Title | jsonify }},
  "baseURL": {{ .Site.BaseURL | jsonify }},
  "description": {{ .Site.Params.description | jsonify }},
  "summaryStatus": {{ $summaryStatus | jsonify }},
  "componentStatusValues": [
    "operational",
    "degraded_performance",
    "partial_outage",
    "major_outage",
    "under_maintenance"
  ],
  "incidentStatusValues": [
    "investigating",
    "identified",
    "monitoring",
    "resolved"
  ],
  "maintenanceStatusValues": [
    "scheduled",
    "in_progress",
    "verifying",
    "completed"
  ],
  "categories": [
    {{- range $index, $category := .Site.Params.categories -}}
      {{- if $index }},{{ end }}
      {
        "name": {{ $category.name | jsonify }},
        "description": {{ default "" $category.description | jsonify }},
        "hideTitle": {{ if $category.untitled }}true{{ else }}false{{ end }},
        "closedByDefault": {{ if $category.closed }}true{{ else }}false{{ end }}
      }
    {{- end }}
  ],
  "systems": [
    {{- range $systemIndex, $system := .Site.Params.systems -}}
      {{- if $systemIndex }},{{ end }}
      {{- $componentIssues := where $active "Params.affected" "intersect" (slice $system.name) -}}
      {{- $rank := 0 -}}
      {{- $status := "operational" -}}
      {{- range $issue := $componentIssues -}}
        {{- $candidate := "" -}}
        {{- with $issue.Params.componentStatus -}}
          {{- $candidate = lower (replace . "-" "_") -}}
        {{- else -}}
          {{- if eq $issue.Params.severity "down" -}}{{- $candidate = "major_outage" -}}
          {{- else if eq $issue.Params.severity "disrupted" -}}{{- $candidate = "partial_outage" -}}
          {{- else if eq $issue.Params.severity "notice" -}}{{- $candidate = "degraded_performance" -}}{{- end -}}
        {{- end -}}
        {{- $candidateRank := 0 -}}
        {{- if eq $candidate "degraded_performance" -}}{{- $candidateRank = 2 -}}{{- end -}}
        {{- if eq $candidate "under_maintenance" -}}{{- $candidateRank = 3 -}}{{- end -}}
        {{- if eq $candidate "partial_outage" -}}{{- $candidateRank = 4 -}}{{- end -}}
        {{- if eq $candidate "major_outage" -}}{{- $candidateRank = 5 -}}{{- end -}}
        {{- if gt $candidateRank $rank -}}{{- $rank = $candidateRank -}}{{- $status = $candidate -}}{{- end -}}
      {{- end }}
      {
        "name": {{ $system.name | jsonify }},
        "description": {{ default "" $system.description | jsonify }},
        "category": {{ $system.category | jsonify }},
        "status": {{ $status | jsonify }},
        "unresolvedIssues": [
          {{- range $issueIndex, $issue := $componentIssues -}}
            {{- if $issueIndex }},{{ end }}
            {{- $issueComponentStatus := "" -}}
            {{- with $issue.Params.componentStatus -}}
              {{- $issueComponentStatus = lower (replace . "-" "_") -}}
            {{- else -}}
              {{- if eq $issue.Params.severity "down" -}}{{- $issueComponentStatus = "major_outage" -}}
              {{- else if eq $issue.Params.severity "disrupted" -}}{{- $issueComponentStatus = "partial_outage" -}}
              {{- else if eq $issue.Params.severity "notice" -}}{{- $issueComponentStatus = "degraded_performance" -}}{{- end -}}
            {{- end }}
            {
              "title": {{ $issue.Title | jsonify }},
              "createdAt": {{ printf "%s" $issue.Date | jsonify }},
              "lastModifiedAt": {{ printf "%s" $issue.Lastmod | jsonify }},
              "permalink": {{ $issue.Permalink | jsonify }},
              "componentStatus": {{ $issueComponentStatus | jsonify }},
              "incidentStatus": {{ default "investigating" $issue.Params.incidentStatus | jsonify }},
              "maintenanceStatus": {{ default "" $issue.Params.maintenanceStatus | jsonify }},
              "legacySeverity": {{ default "" $issue.Params.severity | jsonify }},
              "resolved": {{ if $issue.Params.resolved }}true{{ else }}false{{ end }},
              "resolvedAt": {{ default "" $issue.Params.resolvedWhen | jsonify }},
              "affected": {{ $issue.Params.affected | jsonify }},
              "filename": {{ $issue.File.LogicalName | jsonify }}
            }
          {{- end }}
        ]
      }
    {{- end }}
  ],
  "buildDate": {{ now.Format "2006-01-02" | jsonify }},
  "buildTime": {{ now.Format "15:04:05" | jsonify }},
  "buildTimezone": {{ now.Format "MST" | jsonify }},
  "colors": {
    "brand": {{ .Site.Params.brand | jsonify }},
    "operational": {{ .Site.Params.ok | jsonify }},
    "degradedPerformance": {{ .Site.Params.notice | jsonify }},
    "underMaintenance": {{ .Site.Params.notice | jsonify }},
    "partialOutage": {{ .Site.Params.disrupted | jsonify }},
    "majorOutage": {{ .Site.Params.down | jsonify }}
  }
}
